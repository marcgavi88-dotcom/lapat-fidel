# =============================================================================
# Lapat-fidel — variables d'entorn
# Copia aquest fitxer a `.env.local` i ompla els valors per desenvolupament.
# A producció, defineix-los a Vercel → Project Settings → Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  ·  Project Settings → API
# https://supabase.com/dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon
# Service role: bypassa RLS. NOMÉS server-side. No la posis en cap fitxer client.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secreta_service_role


# -----------------------------------------------------------------------------
# URL pública de l'app
# -----------------------------------------------------------------------------
# Local: http://localhost:3000  ·  Producció: https://fidelitat.apatdelprat.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Resend  ·  emails transaccionals (welcome, butlletí, premis, ressenyes)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_tu_api_key
# Adreça remitent per defecte. Cal que el domini estigui verificat a Resend.
RESEND_FROM_EMAIL=fidelitat@apatdelprat.es
